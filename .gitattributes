# Normalize line endings so Windows and Mac checkouts stay identical
* text=auto

# Code
*.cs        text diff=csharp
*.asmdef    text
*.shader    text
*.hlsl      text

# Unity text-serialized assets (keep LF so diffs stay clean across Windows and Mac)
*.meta       text eol=lf
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.inputactions text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.fbx  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.ttf  binary
*.otf  binary
